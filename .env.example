# Eventbrite API Integration for Certificate Validation
# 1. Generate your Personal OAuth Token at: https://www.eventbrite.com/account-settings/apps
# 2. Add the token below (or set in Netlify Environment Variables in Production):
EVENTBRITE_API_TOKEN=your_eventbrite_private_oauth_token_here

# DevFest 2026 Official Eventbrite Event ID
DEVFEST_EVENTBRITE_EVENT_ID=2004248355785

# Optional: Set to 'true' in development/staging to preview volunteer certificate downloads before Dec 11, 2026
ALLOW_EARLY_VOLUNTEER_CLAIM=false
